{
  "manifest_version": 3,
  "name": "WebToolKit",
  "version": "1.0.0",
  "description": "A powerful collection of useful browser tools.",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}